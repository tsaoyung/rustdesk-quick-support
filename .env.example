# RustDesk QuickSupport Configuration
# Copy this file to .env and fill in your actual values.

# Rendezvous server address (default: rs-ny.rustdesk.com)
RUSTDESK_SERVER=

# Optional: Server authentication key
RUSTDESK_KEY=

# Optional: Socks5 proxy (format: proxy_host:proxy_port)
RUSTDESK_SOCKS5=

# Optional: Pre-set device ID. Leave EMPTY unless you are deploying a single
# unattended machine -- every client carrying the same baked ID will overwrite
# the others on the server. When empty, each installation gets its own random
# 9-digit ID on first run, persisted afterwards (so it is stable per machine).
RUSTDESK_ID=

# Optional: Pre-set a PERMANENT password. Leave EMPTY for the normal support
# workflow: a one-time password is then regenerated on every launch and never
# written to disk, matching the official client ("the temporary password
# refreshes automatically, so there is no lasting open door"). Set it only for
# unattended access, where there is no one to read a fresh password out loud.
RUSTDESK_PASSWORD=

# Direct IP access: let a RustDesk controller dial this machine's IP directly,
# with no rendezvous or relay server involved. Defaults to Y when unset; set to
# N for a relay-only client. Both paths can be active at the same time.
RUSTDESK_DIRECT=Y

# Port the direct listener binds (default: 21118). A controller dialling a bare
# IP omits the port, so only change this if 21118 already collides on the target
# machine -- and open the same port inbound in the firewall if so.
RUSTDESK_DIRECT_PORT=21118

# Optional: restrict WHO may use direct IP access. Comma separated addresses and
# CIDR blocks, e.g. "192.168.1.0/24,10.0.0.7,203.0.113.9/32".
#
# Leave EMPTY (the default) to accept every source -- convenient on a trusted
# LAN, but remember the direct session itself is UNENCRYPTED (the official
# direct path skips the Secure handshake entirely), so anyone who can reach the
# port reaches a login prompt. Set this whenever the machine is not on a network
# you fully control.
RUSTDESK_DIRECT_WHITELIST=

# Optional: build fingerprint, e.g. "1234.a1b2c3d". Shows next to the version in
# the app footer ("0.1.1 . build 1234.a1b2c3d") so several builds of the same
# version can be told apart. CI sets this automatically; fills in for local
# builds only.
RUSTDESK_BUILD=
