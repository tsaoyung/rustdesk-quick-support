# RustDesk QuickSupport Configuration
# Copy this file to .env and fill in your actual values.

# Rendezvous server address (default: rs-ny.rustdesk.com)
RUSTDESK_SERVER=

# Optional: Server authentication key
RUSTDESK_KEY=

# Optional: Socks5 proxy (format: proxy_host:proxy_port)
RUSTDESK_SOCKS5=

# Optional: Pre-set device ID (auto-generated if empty)
RUSTDESK_ID=

# Optional: Pre-set password (auto-generated if empty)
RUSTDESK_PASSWORD=

# Direct IP access: let a RustDesk controller dial this machine's IP directly,
# with no rendezvous or relay server involved. Defaults to Y when unset; set to
# N for a relay-only client. Both paths can be active at the same time.
RUSTDESK_DIRECT=Y

# Port the direct listener binds (default: 21118). A controller dialling a bare
# IP omits the port, so only change this if 21118 already collides on the target
# machine -- and open the same port inbound in the firewall if so.
RUSTDESK_DIRECT_PORT=21118
